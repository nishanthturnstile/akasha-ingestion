AKASHA_ENVIRONMENT=dev
AKASHA_RUNTIME_BACKEND=external
AKASHA_DATA_ROOT=/srv/akasha
AKASHA_HTTP_PORT=8080
POSTGRES_DB=akasha
POSTGRES_USER=akasha
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=akasha
MINIO_ROOT_PASSWORD=change-me
AKASHA_MINIO_BUCKET=akasha-data
# Format: key-name:sha256-hex,key-name-2:sha256-hex
AKASHA_API_KEY_HASHES=
